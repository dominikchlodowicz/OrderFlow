TablePartial bronze_lineage {
  _source_system varchar [not null, note: 'System that produced the source data']
  _source_entity varchar [not null, note: 'Source dataset or entity name']
  _source_file_name varchar [not null, note: 'Name of the physical source file']
  _source_load_date date [not null, note: 'Delivery or partition date assigned by the ingestion convention']
  _source_file_path varchar [not null, note: 'Full physical path of the source file']
  _ingestion_run_id varchar [not null, note: 'Identifier shared by all rows processed in the same Bronze ingestion run']
  _ingested_at timestamp [not null, note: 'UTC timestamp when the row was written to Bronze']
  _raw_record_hash varchar [not null, note: 'SHA-256 hash of the ordered raw source fields, excluding ingestion metadata']
}

Table bronze_calendar {
  date_day varchar
  year varchar
  quarter varchar
  month varchar
  day_of_month varchar
  day_of_week varchar
  day_name varchar
  week_of_year varchar
  is_weekend varchar
  is_polish_public_holiday varchar
  holiday_name varchar
  load_date varchar
  loaded_at varchar

  ~bronze_lineage
}

Table bronze_customers {
  customer_id varchar
  email varchar
  first_name varchar
  last_name varchar
  country_code varchar
  city varchar
  created_at varchar
  updated_at varchar
  customer_status varchar
  marketing_consent varchar
  load_date varchar
  loaded_at varchar
  source_event_at varchar

  ~bronze_lineage
}

